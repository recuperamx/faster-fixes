{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "DOMAIN_NAME",
    "MAIL_DOMAIN",
    "BASE_URL",
    "DATABASE_URL",
    "DB_DRIVER",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "RESEND_API_KEY",
    "RESEND_SEGMENT_ID",
    "PLUNK_SECRET_KEY",
    "STORAGE_REGION",
    "STORAGE_BUCKET_NAME",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_BUCKET_NAME",
    "AWS_REGION",
    "AWS_DEFAULT_REGION",
    "AWS_S3_ENDPOINT",
    "AWS_ENDPOINT_URL",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY",
    "GITHUB_APP_ID",
    "GITHUB_PRIVATE_KEY",
    "GITHUB_WEBHOOK_SECRET",
    "LINEAR_CLIENT_ID",
    "LINEAR_CLIENT_SECRET",
    "LINEAR_OAUTH_REDIRECT_URI",
    "LINEAR_WEBHOOK_SIGNING_SECRET",
    "LINEAR_TOKEN_ENCRYPTION_KEY",
    "SLACK_CLIENT_ID",
    "SLACK_CLIENT_SECRET",
    "SLACK_TOKEN_ENCRYPTION_KEY",
    "JIRA_CLIENT_ID",
    "JIRA_CLIENT_SECRET",
    "JIRA_OAUTH_REDIRECT_URI",
    "JIRA_TOKEN_ENCRYPTION_KEY",
    "JIRA_WEBHOOK_BASE_URL",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SIGNING_SECRET",
    "STRIPE_DEFAULT_TAX_RATE_ID",
    "PRO_MONTHLY_PRICE_ID",
    "PRO_YEARLY_PRICE_ID",
    "AGENCY_MONTHLY_PRICE_ID",
    "AGENCY_YEARLY_PRICE_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "lint:agent-rules": {},
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
